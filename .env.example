# Copy this file to .env and fill in your Firebase project values
# (Project Settings > General > Your apps > SDK setup and configuration)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Places API (New) key used for venue/location search in Create/Edit
# Trip (services/placesService.js). This must be a SEPARATE key from the one
# baked into app.json/AndroidManifest.xml for the embedded map -- that one is
# restricted to "Android apps" (package + SHA-1), which only works for
# requests made through the native Maps SDK, not a plain JS fetch(). Create a
# second key in Google Cloud Console with Application restriction "None" and
# API restriction limited to "Places API (New)" (and "Places API" for
# safety), then paste it below.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
